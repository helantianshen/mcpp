#include <algorithm>
#include <array>
#include <cstdio>
#include <filesystem>
#include <fstream>
#include <iomanip>
#include <iterator>
#include <ostream>
#include <stdexcept>
#include <string>
#include <string_view>
#include <vector>

import mcpp;

namespace {

namespace fs = std::filesystem;

std::vector<unsigned char> read_bytes(const fs::path& path) {
    std::ifstream input(path, std::ios::binary);
    if (!input)
        throw std::runtime_error("cannot open " + path.string());

    std::istreambuf_iterator<char> begin(input);
    std::istreambuf_iterator<char> end;
    std::vector<unsigned char> bytes(begin, end);
    if (bytes.empty())
        throw std::runtime_error("audio file is empty: " + path.string());
    return bytes;
}

void write_bytes(std::ostream& output, std::string_view symbol,
                 const std::vector<unsigned char>& bytes) {
    output << "inline constexpr char " << symbol << "[] =\n";
    for (std::size_t offset = 0; offset < bytes.size(); offset += 24) {
        output << "    \"";
        const auto end = std::min(offset + 24, bytes.size());
        for (std::size_t i = offset; i < end; ++i)
            output << '\\' << std::oct << std::setw(3) << std::setfill('0')
                   << static_cast<unsigned int>(bytes[i]);
        output << "\"\n";
    }
    output << std::dec << ";\n\n";
}

} // namespace

int main() try {
    const fs::path root = mcpp::manifest_dir();
    const fs::path output_path = fs::path(mcpp::out_dir()) / "niulai_assets.cppm";
    const std::array inputs = {
        root / "assets" / "niulai" / "mama1.mp3",
        root / "assets" / "niulai" / "mama2.mp3",
        root / "assets" / "niulai" / "reply.mp3",
    };

    const auto mama1 = read_bytes(inputs[0]);
    const auto mama2 = read_bytes(inputs[1]);
    const auto reply = read_bytes(inputs[2]);

    fs::create_directories(output_path.parent_path());
    std::ofstream output(output_path, std::ios::binary | std::ios::trunc);
    if (!output)
        throw std::runtime_error("cannot create " + output_path.string());

    output << "// Generated by build.mcpp; do not edit.\n"
              "export module mcpp.platform.niulai.assets;\n\n"
              "import std;\n\n"
              "export namespace mcpp::platform::niulai::assets {\n"
              "struct clip {\n"
              "    std::string_view name;\n"
              "    std::span<const char> bytes;\n"
              "};\n"
              "}\n\n"
              "namespace mcpp::platform::niulai::assets::detail {\n\n";
    write_bytes(output, "mama1_data", mama1);
    write_bytes(output, "mama2_data", mama2);
    write_bytes(output, "reply_data", reply);
    output << "} // namespace mcpp::platform::niulai::assets::detail\n\n"
              "export namespace mcpp::platform::niulai::assets {\n\n"
              "clip mama1() noexcept {\n"
              "    return {\"mama1.mp3\", {detail::mama1_data, sizeof(detail::mama1_data) - 1}};\n"
              "}\n\n"
              "clip mama2() noexcept {\n"
              "    return {\"mama2.mp3\", {detail::mama2_data, sizeof(detail::mama2_data) - 1}};\n"
              "}\n\n"
              "clip reply() noexcept {\n"
              "    return {\"reply.mp3\", {detail::reply_data, sizeof(detail::reply_data) - 1}};\n"
              "}\n\n"
              "} // namespace mcpp::platform::niulai::assets\n";
    output.close();
    if (!output)
        throw std::runtime_error("cannot write " + output_path.string());

    for (const auto& input : inputs)
        mcpp::rerun_if_changed(input.string().c_str());
    mcpp::generated(output_path.string().c_str());
    return 0;
} catch (const std::exception& error) {
    std::fprintf(stderr, "build.mcpp: %s\n", error.what());
    return 1;
}
